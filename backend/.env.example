OKAK_APP__NAME=ОКАК API
OKAK_APP__VERSION=0.1.0
OKAK_APP__CORS_ORIGINS=["http://localhost:3000"]

OKAK_POSTGRES__HOST=localhost
OKAK_POSTGRES__PORT=5432
OKAK_POSTGRES__USER=postgres
OKAK_POSTGRES__PASSWORD=postgres
OKAK_POSTGRES__DATABASE=okak

OKAK_AUTH__SECRET_KEY=change-me-in-production
OKAK_AUTH__ALGORITHM=HS256
OKAK_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=10080

OKAK_UPLOADS__UPLOADS_DIR=./uploads
OKAK_UPLOADS__MAX_FILE_SIZE_MB=50

OKAK_LLM__PROVIDER=gigachat
OKAK_LLM__OPENAI_API_KEY=
OKAK_LLM__QWEN_API_KEY=
OKAK_LLM__GIGACHAT_AUTH_KEY=
OKAK_LLM__GIGACHAT_SCOPE=GIGACHAT_API_PERS
OKAK_LLM__GIGACHAT_MODEL=GigaChat
OKAK_LLM__GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
OKAK_LLM__GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
OKAK_LLM__GIGACHAT_VERIFY_SSL_CERTS=true
